{
  "name": "copilot-proxy-server",
  "version": "1.0.0",
  "description": "Standalone proxy server for GitHub Copilot LLM API with OpenAI, Anthropic, and Gemini compatible endpoints",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "auth": "tsx src/index.ts --auth",
    "test:api": "node scripts/test-api.mjs",
    "bench": "node scripts/bench-latency.mjs",
    "bench:quick": "node scripts/bench-latency.mjs --rounds 3 --prompt-size short",
    "bench:full": "node scripts/bench-latency.mjs --rounds 5 --prompt-size medium --output bench-results.json",
    "test": "tsx --test tests/protocol-translation.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "eventsource-parser": "^3.0.0",
    "gpt-tokenizer": "^2.8.1",
    "hono": "^4.13.0",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "cross-env": "^10.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
